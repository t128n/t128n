---
import Wordmark from "@/components/wordmark.astro";
import { site } from "@/lib/site";

const path = Astro.url.pathname;
const isHome = path === "/";
const isBlog = path === "/blog" || path.startsWith("/blog/");
---

<header>
  <a class="header-wordmark" href="/" aria-label={site.title}>
    <Wordmark />
  </a>
  <nav aria-label="Primary">
    <ul>
      <li>
        <a href="/" aria-current={isHome ? "page" : undefined}>home</a>
      </li>
      <li>
        <a href="/blog/" aria-current={isBlog ? "page" : undefined}>blog</a>
      </li>
    </ul>
  </nav>
  <a href="/rss.xml">rss</a>
</header>
