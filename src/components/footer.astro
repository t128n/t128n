---
import { site } from "@/lib/site";

const year = new Date().getFullYear();
---

<footer class="bg-body-tertiary border-top mt-auto">
  <div class="container py-4">
    <div class="d-flex flex-wrap justify-content-center gap-3 mb-2 small">
      <a href={site.social.bluesky} rel="me">
        <i class="bi bi-bluesky me-1" aria-hidden="true"></i>
        Bluesky
      </a>
      <a href={site.social.github} rel="me">
        <i class="bi bi-github me-1" aria-hidden="true"></i>
        GitHub
      </a>
      <a href={site.social.email}>
        <i class="bi bi-envelope me-1" aria-hidden="true"></i>
        Email
      </a>
      <a href="/rss.xml">
        <i class="bi bi-rss me-1" aria-hidden="true"></i>
        RSS
      </a>
    </div>
    <p class="text-center text-body-secondary small mb-0">
      © {year} {site.author} · {site.title}
    </p>
  </div>
</footer>
