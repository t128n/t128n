---
import type { CollectionEntry } from "astro:content";
import Base from "@/layouts/base.astro";
import { formatDate, postUrl } from "@/lib/posts";
import { site } from "@/lib/site";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, publishedAt, updatedAt } = post.data;
const canonical = new URL(postUrl(post), Astro.site ?? site.url);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  ...(description ? { description } : {}),
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: publishedAt.toISOString(),
  ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
  author: {
    "@type": "Person",
    name: site.author,
    url: `${site.url}/`,
  },
};
---

<Base
  title={title}
  description={description ?? site.description}
  type="article"
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <nav aria-label="Breadcrumb">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li aria-current="page">{title}</li>
    </ul>
  </nav>

  <article>
    <hgroup>
      <h1>{title}</h1>
      <p>
        <small>
          Published{" "}
          <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
          {updatedAt && (
            <>
              {" · "}Updated{" "}
              <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
            </>
          )}
        </small>
      </p>
      {description && <p>{description}</p>}
    </hgroup>

    <hr />

    <slot />

    <footer>
      <a href="/blog/">← All posts</a>
    </footer>
  </article>
</Base>
