---
import "bootstrap/dist/css/bootstrap.min.css";
import "bootstrap-icons/font/bootstrap-icons.css";
import "@/styles/site.css";

import Header from "@/components/header.astro";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const ogRoute =
  Astro.url.pathname === "/"
    ? "index"
    : Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-");
const ogImage = new URL(`/og/${ogRoute}.jpg`, Astro.site ?? site.url);
---

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      const colorMode = window.matchMedia("(prefers-color-scheme: dark)");
      const applyColorMode = () => {
        document.documentElement.setAttribute(
          "data-bs-theme",
          colorMode.matches ? "dark" : "light",
        );
      };

      applyColorMode();
      colorMode.addEventListener("change", applyColorMode);
    </script>
    <title>{title === site.title ? title : `${title} · ${site.title}`}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121214" media="(prefers-color-scheme: dark)" />

    {description && <meta name="description" content={description} />}
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${title} — ${site.author}`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="me" href={site.social.github} />
    <link rel="me" href={site.social.bluesky} />
    <link rel="me" href={site.social.email} />

    <slot name="head" />
  </head>
  <body>
    <a
      class="visually-hidden-focusable position-absolute top-0 start-0 z-3 p-2 bg-body"
      href="#main-content"
    >
      Skip to content
    </a>
    <div class="site-container">
      <Header />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
