---
import "marx-css/css/marx.css";

interface Props {
  title?: string;
  description?: string;
  // Open Graph page type: "website" for the site's own pages, "article"
  // for posts. Kept narrow on purpose — the OG spec's article/* fields
  // are the only extras we use.
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title = "t128n.dev",
  description,
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

// Absolute canonical URL: the generated pages always have a trailing
// slash, so pathname already carries the canonical form.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="t128n.dev"
      href="/rss.xml"
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="t128n.dev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <slot name="head" />
    <style is:global>
      :root {
        /* Keep the reading column narrow — plain-text-web measure, not a
           full-bleed app layout. */
        --marx-measure: 700px;

        /* Report/document look: sharp corners (no app-y rounding on
           code/images) and a denser, paper-like heading scale. */
        --marx-radius: 0;
        --marx-text-h1: 1.75rem;
        --marx-text-h2: 1.25rem;
        --marx-text-h3: 1.0625rem;
        --marx-text-h4: 1rem;
        --marx-text-h5: 1rem;
        --marx-text-h6: 1rem;
      }

      /* Marx's own :where(main) already centers itself and adds
         padding-inline: var(--marx-space-md). header gets no such rule by
         default, so give it the identical frame here — otherwise nav text
         sits flush at the column edge while headings/body copy are inset,
         and the two blocks visibly don't line up. */
      body > header {
        max-width: var(--marx-measure);
        margin-inline: auto;
        padding-inline: var(--marx-space-md);
      }

      /* Standing heads (academic report / man-page model):
         h1/h2 sit on the left margin, forming a scannable rail; the
         content a heading introduces sets one step in. Sub-headings
         step halfway — subordinate, but never inside the text column. */
      main :where(h3, h4, h5, h6) {
        margin-inline-start: 1rem;
      }

      main :where(p, ul, ol, dl, blockquote, small) {
        margin-inline-start: 2rem;
      }

      /* Elements inside a list item, quote, or definition detail are
         already in the content column — don't indent them twice. */
      main :where(li, blockquote, dd) :where(p, ul, ol, dl, blockquote, small) {
        margin-inline-start: 0;
      }

      /* Post date acts as a byline: rail-aligned under the title. */
      main article header p {
        margin-inline-start: 0;
      }

      /* Paper-style headings: bold throughout, numbered inside posts.
         Numbers come from CSS counters (markdown renders flat siblings),
         so no content changes are needed — just the .post class. */
      main :where(h1, h2, h3, h4, h5, h6) {
        font-weight: 600;
      }

      main article.post {
        counter-reset: section;
      }

      main article.post :where(h2) {
        counter-increment: section;
        counter-reset: subsection;
      }

      main article.post :where(h2)::before {
        content: counter(section) ".\00a0";
      }

      main article.post :where(h3) {
        counter-increment: subsection;
      }

      main article.post :where(h3)::before {
        content: counter(section) "." counter(subsection) ".\00a0";
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
