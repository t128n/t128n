---
import { getCollection } from "astro:content";
import Base from "@/layouts/base.astro";
import { site } from "@/lib/site";
import { formatDate, isPublished, postUrl, sortByPublishedAt } from "@/lib/posts";

export const title = site.blog.title;
export const description = site.blog.description;

const posts = (await getCollection("blog"))
  .filter((post) => isPublished(post))
  .toSorted(sortByPublishedAt);
---

<Base title={title} description={description}>
  <h1>{title}</h1>
  <p class="page-description">{description}</p>

  {posts.length === 0 ? (
    <p class="page-description">No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt, "medium")}
          </time>
          {" — "}
          <a href={postUrl(post)}>{post.data.title}</a>
          {post.data.description && (
            <p class="post-description">{post.data.description}</p>
          )}
        </li>
      ))}
    </ul>
  )}

  <p>
    <a href="/rss.xml">RSS feed</a>
  </p>
</Base>
