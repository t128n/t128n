---
import { getCollection } from "astro:content";
import Base from "@/layouts/base.astro";
import { site } from "@/lib/site";
import { formatDate, isPublished, postUrl, sortByPublishedAt } from "@/lib/posts";

export const title = site.blog.title;
export const description = site.blog.description;

const posts = (await getCollection("blog"))
  .filter((post) => isPublished(post))
  .toSorted(sortByPublishedAt);
---

<Base title={title} description={description}>
  <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
    <h1 class="mb-0">Blog</h1>
    <a href="/rss.xml">
      <i class="bi bi-rss me-1" aria-hidden="true"></i>
      RSS
    </a>
  </div>

  <p class="lead">{description}</p>

  {posts.length === 0 ? (
    <p class="text-body-secondary">
      No posts yet. <a href="/rss.xml">Subscribe via RSS</a> to read them when they appear.
    </p>
  ) : (
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col" class="text-nowrap">Date</th>
            <th scope="col">Post</th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr>
              <td class="text-nowrap text-body-secondary">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt, "medium")}
                </time>
              </td>
              <td>
                <a href={postUrl(post)} class="fw-semibold">
                  {post.data.title}
                </a>
                {post.data.description && (
                  <div class="small text-body-secondary">{post.data.description}</div>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Base>
