---
import { getCollection } from "astro:content";
import Base from "@/layouts/base.astro";
import { site } from "@/lib/site";
import { formatDate, isPublished, postUrl, sortByPublishedAt } from "@/lib/posts";

export const title = site.blog.title;
export const description = site.blog.description;

const posts = (await getCollection("blog"))
  .filter((post) => isPublished(post))
  .toSorted(sortByPublishedAt);
---

<Base title={title} description={description}>
  <h1>blog</h1>
  <p>{description}</p>

  {posts.length === 0 ? (
    <p><small>No posts yet.</small></p>
  ) : (
    <table>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Post</th>
        </tr>
      </thead>
      <tbody>
        {posts.map((post) => (
          <tr>
            <td>
              <small>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt, "medium")}
                </time>
              </small>
            </td>
            <td>
              <a href={postUrl(post)}>{post.data.title}</a>
              {post.data.description && (
                <div><small>{post.data.description}</small></div>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Base>
