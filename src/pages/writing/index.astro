---
import { getCollection } from "astro:content";
import Base from "@/layouts/base.astro";
import { isPublished, sortByDate, writingUrl } from "@/lib/posts";

export const title = "Writing";
export const description = "Collection of writings about all things tech.";

const writings = (await getCollection("writing"))
  .filter(isPublished)
  .toSorted(sortByDate);
---

<Base
  title={title}
  description={description}
>
  <main>
    <h1>Writing</h1>

    {writings.length === 0 ? (
      <p>No writings yet.</p>
    ) : (
      <ul class="writings-list">
        {writings.map((writing) => (
          <li>
            <time datetime={writing.data.pubDate.toISOString()}>
              {writing.data.pubDate.toLocaleDateString("en-US", {
                timeZone: "UTC",
                year: "numeric",
                month: "short",
                day: "2-digit",
              })}
            </time>
            {" — "}
            <a href={writingUrl(writing)} class="writing-title-link">
              {writing.data.title}
            </a>
            {writing.data.description && (
              <p class="writing-desc">{writing.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    )}
  </main>
</Base>
