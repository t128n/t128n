---
import Base from "@/layouts/Base.astro";
import { site } from "@/lib/site";
import { getCollection } from "astro:content";
import { isPublished } from "@/lib/posts";

const posts = (await getCollection("writing")).filter(isPublished);
---

<Base
  title={site.author}
  description={site.description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: site.author,
    url: `${site.url}/`,
    sameAs: [
      site.social.bluesky,
      site.social.github,
    ],
  })} />

  <main transition:animate="fade">
    <h1>{site.author}</h1>
    <p>{site.description}</p>
    {posts.length > 0 && (
      <p>I sometimes <a href="/writing/">write about stuff</a>.</p>
    )}

    <h2>Connect</h2>
    <ul>
      <li><a href={site.social.bluesky}>Bluesky</a></li>
      <li><a href={site.social.github}>GitHub</a></li>
    </ul>
  </main>
</Base>
