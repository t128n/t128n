---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
---

<BaseLayout
  title="Torben Haack"
  description="Technical Product Owner and Software Engineer in the automotive industry. Building and managing data and software systems, contributing to FOSS, studying Business Informatics at BHT Berlin."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Torben Haack",
    url: "https://t128n.dev/",
    sameAs: [
      "https://bsky.app/profile/t128n.dev",
      "https://github.com/t128n",
    ],
  })} />
  <Header />

  <main>
    <h1>Torben Haack</h1>
    <p>
      Technical Product Owner and Software Engineer in the automotive
      industry. I build and manage data and software systems, contribute to
      FOSS, and study Business Informatics part-time at BHT Berlin. I
      sometimes <a href="/writing/">write about stuff</a>.
    </p>

    <h2>Connect</h2>
    <ul>
      <li><a href="https://bsky.app/profile/t128n.dev">Bluesky</a></li>
      <li><a href="https://github.com/t128n">GitHub</a></li>
    </ul>
  </main>
</BaseLayout>
