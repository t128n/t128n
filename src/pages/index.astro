---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import avatar from "@/assets/t128n.png";
---

<BaseLayout title="Torben Haack">
  <Header />

  <main>
    <Image src={avatar} alt="Torben Haack" width={72} height={72} class="avatar" />
    <h1>Torben Haack</h1>
    <p>
      Technical Product Owner and Software Engineer in the automotive
      industry. I build and manage data and software systems, contribute to
      FOSS, and study Business Informatics part-time at BHT Berlin. I
      sometimes <a href="/writing/">write about stuff</a>.
    </p>

    <h2>Connect</h2>
    <ul>
      <li><a href="https://bsky.app/profile/t128n.dev">Bluesky</a></li>
      <li><a href="https://github.com/t128n">GitHub</a></li>
    </ul>
  </main>
</BaseLayout>

<style>
  /* Marx rounds img/video by default; a flat headshot fits the plain-text
     aesthetic better than a softened one. */
  /* .avatar {
    border-radius: 0;
  } */
</style>
