---
import Base from "@/layouts/base.astro";
import { site } from "@/lib/site";
import { getCollection } from "astro:content";
import { formatDate, isPublished, postUrl, sortByPublishedAt } from "@/lib/posts";

export const title = site.title;
export const description = site.description;

const posts = (await getCollection("blog"))
  .filter((post) => isPublished(post))
  .toSorted(sortByPublishedAt);
---

<Base title={title} description={description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: site.author,
      url: `${site.url}/`,
      sameAs: [site.social.bluesky, site.social.github],
    })}
  />

  <div class="row g-4">
    <div class="col-lg-8">
      <h1 class="mb-3">{site.author}</h1>
      <p class="lead">{site.description}</p>

      {posts.length > 0 && (
        <>
          <h2 class="h4 mt-4 mb-3">Recent posts</h2>
          <div class="list-group list-group-flush">
            {posts.slice(0, 3).map((post) => (
              <a class="list-group-item list-group-item-action px-0" href={postUrl(post)}>
                <div class="d-flex flex-wrap justify-content-between gap-2">
                  <span class="fw-semibold">{post.data.title}</span>
                  <time class="small text-body-secondary" datetime={post.data.publishedAt.toISOString()}>
                    {formatDate(post.data.publishedAt, "medium")}
                  </time>
                </div>
                {post.data.description && (
                  <div class="small text-body-secondary mt-1">{post.data.description}</div>
                )}
              </a>
            ))}
          </div>
          <p class="mt-3 mb-0">
            <a href="/blog/">All posts →</a>
          </p>
        </>
      )}
    </div>

    <div class="col-lg-4">
      <h2 class="h4 mb-3">Connect</h2>
      <ul class="list-unstyled">
        <li class="mb-2">
          <i class="bi bi-bluesky me-1" aria-hidden="true"></i>
          <a href={site.social.bluesky} rel="me">Bluesky</a>
        </li>
        <li class="mb-2">
          <i class="bi bi-github me-1" aria-hidden="true"></i>
          <a href={site.social.github} rel="me">GitHub</a>
        </li>
        <li class="mb-2">
          <i class="bi bi-envelope me-1" aria-hidden="true"></i>
          <a href={site.social.email}>Email</a>
        </li>
      </ul>
    </div>
  </div>
</Base>
