---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/base.astro";
import { isPublished, writingUrl, writingUrlParams } from "@/lib/posts";
import { site } from "@/lib/site";

export async function getStaticPaths() {
  const writings = (await getCollection("writing")).filter(isPublished);

  return writings.map((writing) => ({
    params: writingUrlParams(writing),
    props: { writing },
  }));
}

const { writing } = Astro.props;
const { Content } = await render(writing);

const writingAuthorName =
  typeof writing.data.author === "object"
    ? writing.data.author.name
    : (writing.data.author ?? site.author);
const writingAuthorUrl =
  typeof writing.data.author === "object" && writing.data.author.url
    ? writing.data.author.url
    : writing.data.author && writing.data.author !== site.author
      ? undefined
      : `${site.url}/`;
const author = {
  "@type": "Person",
  name: writingAuthorName,
  ...(writingAuthorUrl ? { url: writingAuthorUrl } : {}),
};
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: writing.data.title,
  description: writing.data.description,
  url: new URL(writingUrl(writing), Astro.site ?? "https://t128n.dev"),
  mainEntityOfPage: new URL(writingUrl(writing), Astro.site ?? "https://t128n.dev"),
  datePublished: writing.data.pubDate.toISOString(),
  ...(writing.data.updatedDate && {
    dateModified: writing.data.updatedDate.toISOString(),
  }),
  author,
  ...(writing.data.cover && {
    image: writing.data.cover.src,
  }),
};
---

<Base
  title={writing.data.title}
  description={writing.data.description}
  type="article"
  publishedTime={writing.data.pubDate}
  modifiedTime={writing.data.updatedDate}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main>
    <article class="writing">
      <header class="writing-header">
        <h1 class="writing-title">{writing.data.title}</h1>
        <p class="writing-meta">
          <time datetime={writing.data.pubDate.toISOString()}>
            {writing.data.pubDate.toLocaleDateString("en-US", {
              timeZone: "UTC",
              dateStyle: "long",
            })}
          </time>
          {writing.data.updatedDate && (
            <>
              {" "}· updated{" "}
              <time datetime={writing.data.updatedDate.toISOString()}>
                {writing.data.updatedDate.toLocaleDateString("en-US", {
                  timeZone: "UTC",
                  dateStyle: "long",
                })}
              </time>
            </>
          )}
        </p>
      </header>

      {writing.data.cover && (
        <figure>
          <img src={writing.data.cover.src} alt={writing.data.coverAlt ?? ""} />
          {writing.data.coverAlt && <figcaption>{writing.data.coverAlt}</figcaption>}
        </figure>
      )}

      <Content />

      <footer class="writing-footer">
        <p class="writing-author">
          —{" "}
          {writingAuthorUrl ? (
            <a href={writingAuthorUrl}>{writingAuthorName}</a>
          ) : (
            writingAuthorName
          )}
        </p>
      </footer>
    </article>
  </main>
</Base>
